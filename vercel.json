{
  "rewrites": [
    { "source": "/join/:code", "destination": "/join/index.html" },
    { "source": "/e/:code", "destination": "/e/index.html" }
  ],
  "headers": [
    {
      "source": "/.well-known/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}

